meta {
  name: 2 Login cliente
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  { "email": "cliente@demo.local", "password": "demo1234" }
}

assert {
  res.status: eq 200
}

script:post-response {
bru.setVar("customerToken", res.body.accessToken);
}

docs {
  Devuelve un JWT con el rol CUSTOMER. Se guarda en la variable customerToken.
}
