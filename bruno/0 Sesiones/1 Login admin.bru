meta {
  name: 1 Login admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  { "email": "admin@demo.local", "password": "demo1234" }
}

assert {
  res.status: eq 200
}

script:post-response {
bru.setVar("token", res.body.accessToken);
}

docs {
  Devuelve un JWT con el rol ADMIN. Se guarda en la variable token.
}
