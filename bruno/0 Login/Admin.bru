meta {
  name: Admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  { "email": "admin@demo.local", "password": "demo1234" }
}

assert {
  res.status: eq 200
}

script:post-response {
bru.setVar("token", res.body.accessToken);
}

docs {
  Guarda el token en la variable token. Ejecutar antes que el resto de las carpetas.
}
