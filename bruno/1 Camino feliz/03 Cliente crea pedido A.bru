meta {
  name: 03 Cliente crea pedido A
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

body:json {
  {
    "type": "CUSTOMER",
    "deliveryAddress": { "latitude": -38.703, "longitude": -62.285 },
    "items": [{ "productId": "{{productId}}", "quantity": 1 }]
  }
}

assert {
  res.status: eq 201
  res.body.status: eq pending
}

script:post-response {
bru.setVar("orderA", res.body.id);
}

docs {
  El cliente no manda su id: sale del token. El sistema elige la sucursal mas cercana con stock completo (Strategy) y descuenta el stock en la misma transaccion.
}
