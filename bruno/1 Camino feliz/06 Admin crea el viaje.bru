meta {
  name: 06 Admin crea el viaje
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/trips
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "orderIds": ["{{orderA}}", "{{orderB}}"] }
}

assert {
  res.status: eq 201
  res.body.status: eq planned
}

script:post-response {
bru.setVar("tripId", res.body.id);
bru.setVar("deliveryPersonId", res.body.deliveryPersonId);
}

docs {
  Solo manda los pedidos. El sistema deduce la sucursal de origen y asigna el repartidor libre con menos viajes (Strategy). Guarda el viaje y publica el pedido de rutas en RabbitMQ: responde enseguida y las rutas llegan despues.
}
