meta {
  name: 3 Crear viaje
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/trips
  body: json
  auth: bearer
}

body:json {
  {
    "orderIds": ["{{orderA}}", "{{orderB}}"]
  }
}

assert {
  res.status: eq 201
  res.body.status: eq planned
}

script:post-response {
bru.setVar("tripId", res.body.id);
}

docs {
  El sistema asigna solo un repartidor libre de la sucursal de origen. Guarda el viaje y le pide las rutas al servicio de Python por RabbitMQ. Responde enseguida; las rutas llegan despues.
}

auth:bearer {
  token: {{token}}
}
