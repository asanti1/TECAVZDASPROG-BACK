meta {
  name: 6 Ultima ubicacion del repartidor
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/trips/{{tripId}}/location
  body: none
  auth: bearer
}

assert {
  res.status: eq 200
}

docs {
  Para mover al repartidor: cd backend && node scripts/simulate-driver.mjs <tripId>. El id del viaje esta en la variable tripId.
}

auth:bearer {
  token: {{token}}
}
