meta {
  name: 2 Crear pedido B
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

body:json {
  {
    "type": "CUSTOMER",
    "customerId": "{{customerId}}",
    "deliveryAddress": { "latitude": -38.72, "longitude": -62.27 },
    "items": [{ "productId": "{{productId}}", "quantity": 1 }]
  }
}

assert {
  res.status: eq 201
}

script:post-response {
bru.setVar("orderB", res.body.id);
}

auth:bearer {
  token: {{token}}
}
