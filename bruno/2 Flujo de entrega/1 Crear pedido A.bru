meta {
  name: 1 Crear pedido A
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

body:json {
  {
    "type": "CUSTOMER",
    "customerId": "{{customerId}}",
    "deliveryAddress": { "latitude": -38.714, "longitude": -62.265 },
    "items": [{ "productId": "{{productId}}", "quantity": 1 }]
  }
}

assert {
  res.status: eq 201
  res.body.status: eq pending
}

script:post-response {
bru.setVar("orderA", res.body.id);
}

docs {
  Crea un pedido de cliente. El sistema elige la sucursal mas cercana con stock y descuenta el stock.
}

auth:bearer {
  token: {{token}}
}
