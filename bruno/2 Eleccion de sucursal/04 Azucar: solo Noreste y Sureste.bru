meta {
  name: 04 Azucar: solo Noreste y Sureste
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

body:json {
  {
    "type": "CUSTOMER",
    "deliveryAddress": { "latitude": -38.702, "longitude": -62.285 },
    "items": [
      { "productId": "a0000000-0000-4000-8000-000000000005", "quantity": 1 }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.originBranchId: eq b0000000-0000-4000-8000-000000000002
}

docs {
  Gana Noreste: es la mas cercana de las que tienen azucar.
}
