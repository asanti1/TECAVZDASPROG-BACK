meta {
  name: 02 Yerba: gana la mas cercana
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

body:json {
  {
    "type": "CUSTOMER",
    "deliveryAddress": { "latitude": -38.702, "longitude": -62.285 },
    "items": [
      { "productId": "a0000000-0000-4000-8000-000000000001", "quantity": 1 }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.originBranchId: eq b0000000-0000-4000-8000-000000000001
}

docs {
  Todas tienen yerba, asi que gana la mas cercana al cliente: Noroeste.
}
