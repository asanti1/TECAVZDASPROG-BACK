meta {
  name: 03 Leche: solo hay en el sur
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

body:json {
  {
    "type": "CUSTOMER",
    "deliveryAddress": { "latitude": -38.702, "longitude": -62.285 },
    "items": [
      { "productId": "a0000000-0000-4000-8000-000000000007", "quantity": 1 }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.originBranchId: eq b0000000-0000-4000-8000-000000000003
}

docs {
  El cliente esta en el norte, pero la leche solo la tienen Suroeste y Sureste. Gana la mas cercana de las dos: Suroeste.
}
